<Scene>
<Panel Width="640" Height="480" Anchor="Center">
	<Panel Anchor="Center" Width="160" Height="247" X="-214" Y="-26" ID="leftpanel" Visible="false">
		<Panel.Background>
			<DisplayModel model="nav_navmap_left"/>
		</Panel.Background>
    <ListBox ID="waypoint_list" X="16" Y="14" Width="143" Height="174" ItemHeight="58" ItemWidth="127" OverlayScrollbar="true"/>
		<Button ID="clear_waypoints" Style="wirebutton_navpanel" X="16" Y="205" Width="127" Height="25" Text="Clear All Waypoints" TextSize="10"/>
	</Panel>
	<Panel Anchor="Center" Width="160" Height="247" X="216" Y="-26" ID="rightpanel" Visible="false">
		<Panel.Background>
			<DisplayModel model="nav_navmap_right"/>
		</Panel.Background>
		<TextBlock ID="mission_title" X="17" Y="14" Width="126" Height="18" Text="ACTIVE MISSION" TextColor="text" TextShadow="black" TextSize="9" HorizontalAlignment="Center" Visible="false"/>
		<InfocardDisplay ID="mission_description" X="18" Y="37" Width="124" Height="184" Visible="false"/>
	</Panel>
	
	<Panel Anchor="Center" Width="263" Height="292" X="2" Y="-23" ID="background">
		<Panel.Background>
			<DisplayModel model="navmap_background"/>
		</Panel.Background>

		<Panel Width="263" Height="292" ID="contents">
			<Navmap Width="232" Height="235" X="15" Y="29.5" ID="navmap">
			</Navmap>
			<Panel ID="legend" Width="232" Height="235" X="15" Y="29.5" Visible="false">
				<Panel.Background>
					<DisplayColor color="rgba(0,0,0,0.35)"/>
				</Panel.Background>
				<TextBlock X="8" Y="8" Width="216" Height="18"
					Text="NAVMAP LEGEND" TextColor="text" TextShadow="black" TextSize="11"
					HorizontalAlignment="Center" VerticalAlignment="Top"/>
				<TextBlock X="8" Y="34" Width="216" Height="193"
					Text="Legend test text" TextColor="text" TextShadow="black" TextSize="9"
					HorizontalAlignment="Left" VerticalAlignment="Top" Wrap="true"/>
			</Panel>
			<TextBlock ID="knownbases_title" X="23" Y="31.5" Width="216" Height="18"
				Text="BASE LIST" TextColor="text" TextShadow="black" TextSize="11"
				HorizontalAlignment="Center" VerticalAlignment="Top" Visible="false"/>
			<DataTable ID="knownbases_table" X="25" Y="53.5" Width="217" Height="207.5"
				Visible="false" DisplayRowCount="13" BodyFont="$NavMap800" BodyTextSize="8"
				BodyColor="text" BodyHover="text_hover" SelectedColor="yellow"
				HeaderFont="$NavMap800" HeaderTextSize="11" HeaderColor="text" HeaderActiveColor="yellow"
				ActiveSortColumn="name"
				TextShadow="black"
				ShowHeaders="true" ShowColumnBorders="false" ShowRowBorders="false">
				<DataTable.Scrollbar Width="8"/>
				<DataTable.Columns>
					<TableColumn Label="BASE NAMES" Data="name" InitialWidthPercent="48" TextAlignment="left"/>
					<TableColumn Label="SYSTEM NAME" Data="system" InitialWidthPercent="52" TextAlignment="left"/>
				</DataTable.Columns>
			</DataTable>
			<TextBlock ID="knownbases_empty" X="25" Y="71.5" Width="199" Height="20"
				Text="No known bases" TextColor="text" TextShadow="black" TextSize="9"
				HorizontalAlignment="Center" VerticalAlignment="Top" Visible="false"/>
				<Button Style="nav_universebutton" X="15" Y="9" ID="universebutton" DrawText="false" Strid="8604"/>
				<Button Style="nav_labels" X="35" Y="9" ID="labels" DrawText="false" Strid="1046"/>
				<Button Style="nav_filter_physical" X="85" Y="9" ID="physical" DrawText="false" Strid="1235"/>
				<Button Style="nav_filter_political" X="105" Y="9" ID="political" DrawText="false" Strid="1236"/>
				<Button Style="nav_patrol" X="125" Y="9" ID="patrol" DrawText="false" Strid="1313"/>
				<Button Style="nav_minablezonefilter" X="145" Y="9" ID="miningfilter" DrawText="false" Strid="1359"/>
				<Button Style="nav_legendtoggle" X="165" Y="9" ID="legendtoggle" DrawText="false" Strid="1358"/>
				<Button Style="nav_knownbases" X="185" Y="9" ID="knownbases" DrawText="false" Strid="967"/>
				<Button Style="nav_gotoship" X="217" Y="9" ID="playersystem" DrawText="false" Strid="1246" Visible="false"/>
				<Button Style="xbutton" X="235" Y="9" Width="12" Height="12" ID="exit"/>
		</Panel>
	</Panel>
</Panel>
</Scene>
